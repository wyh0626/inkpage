{
  "name": "inkpage",
  "version": "1.1.0",
  "private": true,
  "description": "E-ink reading mode for Chrome, Edge, Firefox and Safari",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "python3 scripts/icons.py src/icons store/icon-1024.png",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "safari:xcode": "node scripts/safari-xcode.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "node test/e2e.mjs",
    "store": "node scripts/store-assets.mjs",
    "safari:app": "sh scripts/build-safari-app.sh"
  }
}
